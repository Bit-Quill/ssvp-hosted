{
  "name": "snowflake-excel-addin",
  "version": "1.0.0",
  "description": "Excel Add-in for Snowflake Semantic Views",
  "repository": {
    "type": "git",
    "url": "https://github.com/snowflake/snowflake-excel-addin.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "dev": "webpack serve --mode development",
    "server": "node server/server.js",
    "test": "jest",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "generate-certs": "office-addin-dev-certs install",
    "watch": "webpack --mode development --watch",
    "deploy": "npm run build:prod && git add . && git status",
    "deploy:help": "echo '\n🚀 Simple Deployment:\n\n1. npm run build:prod\n2. git add .\n3. git commit -m \"Deploy\"\n4. git push origin main\n\n✅ GitHub Actions despliega automáticamente a:\nhttps://bit-quill.github.io/ssvp-hosted/\n\n📖 Más info: cat STATIC_DEPLOYMENT.md\n'"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.12.11",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "acorn": "^8.11.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "eslint-plugin-office-addins": "^2.1.8",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^1.6.3",
    "office-addin-debugging": "^5.1.3",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-lint": "^2.3.3",
    "office-addin-manifest": "^1.13.3",
    "office-addin-prettier-config": "^1.2.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
