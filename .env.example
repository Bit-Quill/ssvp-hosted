# Snowflake Excel Plugin - Environment Configuration
# Copy this file to .env and fill in your actual values

# ========== Server Configuration ==========
NODE_ENV=development
PORT=3000

# Allowed origins for CORS (comma-separated)
# For development, use http://localhost:3000
# For production, use your actual domain
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# ========== Snowflake OAuth Configuration ==========

# OAuth Client ID from Snowflake Security Integration
# Create via: CREATE SECURITY INTEGRATION excel_oauth_integration...
SNOWFLAKE_OAUTH_CLIENT_ID=your_client_id_here

# OAuth Client Secret from Snowflake Security Integration
SNOWFLAKE_OAUTH_CLIENT_SECRET=your_client_secret_here

# Default Snowflake Account
# Format: <account_identifier> (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_account_here

# OAuth Redirect URI
# Must match the redirect URI configured in Snowflake Security Integration
# For development: http://localhost:3000/auth/callback
# For production: https://your-domain.com/auth/callback
SNOWFLAKE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth Scopes (space-separated)
# Common scopes: session:role-any, refresh_token
SNOWFLAKE_OAUTH_SCOPES=session:role-any refresh_token

# ========== Optional Configuration ==========

# Default Warehouse (optional)
SNOWFLAKE_DEFAULT_WAREHOUSE=

# Default Role (optional)
SNOWFLAKE_DEFAULT_ROLE=

# ========== Security Configuration ==========

# Session secret for cookie signing (generate a random string)
SESSION_SECRET=your_random_session_secret_here

# Token encryption key (32 characters, generate randomly)
TOKEN_ENCRYPTION_KEY=your_32_character_encryption_key

# ========== Logging Configuration ==========

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable request logging (true/false)
ENABLE_REQUEST_LOGGING=true

# ========== Feature Flags ==========

# Enable Cortex Analyst integration
ENABLE_CORTEX_ANALYST=true

# Enable Key-Pair authentication
ENABLE_KEYPAIR_AUTH=false

# Enable PAT authentication
ENABLE_PAT_AUTH=true
